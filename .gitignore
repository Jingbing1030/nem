# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# Android
.gradle/
app/android/local.properties
app/android/key.properties
*.jks
*.keystore

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# 本地临时
*.log
*.bak
*.bak.*

# pubspec.lock 含本机 pub 镜像 URL（127.0.0.1 代理），跨环境无意义；
# 交给各环境自行 pub get 解析。
pubspec.lock

# 构建产物：APK 有 100MB+，绝不能提交进仓库
*.apk
*.aab

# Python 字节码缓存（.github/scripts/*.py 被本地调试时会产生，
# 属于机器生成物，不该进仓库）
__pycache__/
*.py[cod]
